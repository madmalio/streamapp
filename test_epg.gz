		<episode-num system="xmltv_ns">3.1.</episode-num>
		<previously-shown/>
	</programme>
	<programme start="20260722030000 +0000" stop="20260722040000 +0000" channel="US102182.hdhomerun.com">
		<title>Interview With a Killer</title>
		<sub-title>Unmasked - Celeste Beard Johnson</sub-title>
		<desc lang="en">She's one of the most camera-friendly killers in true crime history. A glamorous Texas social climber turned convicted black widow. Celeste Beard Johnson has done many television interviews, flashing a smile as she proclaims her innocence and pleads for sympathy. But she's never been questioned by David Scott. And this interview is unlike any that she's ever done. In this special episode of Interview With a Killer, host David Scott reveals the real Celeste - cunning, calculating, and deadly.</desc>
		<date>20260531</date>
		<category>Series</category>
		<category>Crime</category>
